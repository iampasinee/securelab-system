# Local Docker development only. Copy to .env and replace this placeholder.
POSTGRES_DB=securelab
POSTGRES_USER=securelab_migration
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
BACKEND_PORT=8000

# Keep credentials in sync with POSTGRES_* above; URL-encode special characters.
# postgres is the Compose service hostname, not localhost.
APP_DB_PASSWORD=change_me_app_password
DATABASE_URL=postgresql+psycopg://securelab_app:change_me_app_password@postgres:5432/securelab
MIGRATION_DATABASE_URL=postgresql+psycopg://securelab_migration:change_me@postgres:5432/securelab
STORAGE_ROOT=/data/securelab
JWT_SECRET=replace_with_random_server_secret_at_least_32_bytes
FRONTEND_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
# Development HTTP only. Set true behind HTTPS.
COOKIE_SECURE=false
ENABLE_DEVELOPMENT_SIMULATION=false
