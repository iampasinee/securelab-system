# Optional for /health. Required when running database operations locally.
# Use localhost outside Compose; update credentials to match root .env.
DATABASE_URL=postgresql+psycopg://securelab_app:change_me_app_password@localhost:5432/securelab
MIGRATION_DATABASE_URL=postgresql+psycopg://securelab_migration:change_me@localhost:5432/securelab
APP_DB_PASSWORD=change_me_app_password
STORAGE_ROOT=../storage/data
JWT_SECRET=replace_with_random_server_secret_at_least_32_bytes
FRONTEND_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
ENABLE_DEVELOPMENT_SIMULATION=false
